# =============================================================================
# Docker Compose env — copy file này thành infra/.env
#   Copy-Item infra/.env.example infra/.env   (PowerShell)
#   cp infra/.env.example infra/.env          (bash)
#
# Compose tự đọc infra/.env (cùng thư mục với docker-compose.yml).
# Để chạy NHIỀU DỰ ÁN ĐỒNG THỜI: mỗi dự án dùng COMPOSE_PROJECT_NAME riêng và
# một dải port riêng (xem bảng ví dụ cuối file).
# =============================================================================

# Tên project: prefix container / volume / network → tránh trùng giữa các dự án
COMPOSE_PROJECT_NAME=ats

# Cổng host (đổi khi bị chiếm hoặc khi chạy song song nhiều dự án)
ATS_POSTGRES_PORT=5433
ATS_REDIS_PORT=6379
ATS_RUSTFS_PORT=9000
ATS_RUSTFS_CONSOLE_PORT=9001
ATS_SMTP_PORT=1025
ATS_MAILPIT_PORT=8025
ATS_API_PORT=3000
ATS_AI_PORT=8010
ATS_WEB_PORT=5173

# URL public của web — dùng cho CORS của Core API
ATS_WEB_ORIGIN=http://localhost:5173
# development = bật Swagger /api/docs; production = tắt
ATS_NODE_ENV=development
ATS_RUN_SEED=true

# -----------------------------------------------------------------------------
# Email (dev dùng Mailpit; production đổi SMTP_* sang nhà cung cấp thật)
# -----------------------------------------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AI-Powered ATS <no-reply@ats.local>

# -----------------------------------------------------------------------------
# Database (chỉ dùng bên trong compose; host port ở trên)
# -----------------------------------------------------------------------------
ATS_DB_USER=ats
ATS_DB_PASSWORD=ats_local_password
ATS_DB_NAME=ats

# -----------------------------------------------------------------------------
# Secrets — BẮT BUỘC đổi ở production
# -----------------------------------------------------------------------------
# ≥ 32 ký tự
JWT_SECRET=dev-only-jwt-secret-change-me-32-characters
BCRYPT_ROUNDS=12

# Dùng chung giữa Core API và AI Service
AI_INTERNAL_TOKEN=change-me-internal-service-token

# S3 / RustFS (dev mặc định minioadmin)
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_BUCKET_CV=cv-files
S3_SIGNED_URL_TTL=600

# CAPTCHA (để trống = tắt)
TURNSTILE_SECRET_KEY=

# -----------------------------------------------------------------------------
# AI Service
# -----------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=
LLM_API_BASE=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_ENABLED=true
AI_ANALYZE_TIMEOUT_MS=120000

LOG_LEVEL=info

# =============================================================================
# Ví dụ chạy 2 dự án song song (tạo thêm infra/.env.du-an-b rồi:
#   docker compose --env-file infra/.env.du-an-b -f infra/docker-compose.yml --profile app up -d)
#
#   Biến                      Dự án A (mặc định)   Dự án B
#   COMPOSE_PROJECT_NAME      ats                  ats-b
#   ATS_POSTGRES_PORT         5433                 5533
#   ATS_REDIS_PORT            6379                 6479
#   ATS_RUSTFS_PORT           9000                 9100
#   ATS_RUSTFS_CONSOLE_PORT   9001                 9101
#   ATS_SMTP_PORT             1025                 1125
#   ATS_MAILPIT_PORT          8025                 8125
#   ATS_API_PORT              3000                 3100
#   ATS_AI_PORT               8010                 8110
#   ATS_WEB_PORT              5173                 5273
#   ATS_WEB_ORIGIN            http://localhost:5173  http://localhost:5273
# =============================================================================
