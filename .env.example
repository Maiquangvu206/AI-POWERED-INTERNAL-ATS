# =============================================================================
# AI-Powered Internal ATS — biến môi trường mẫu
# Sao chép thành .env rồi điền giá trị thật:  cp .env.example .env
# KHÔNG commit file .env
# =============================================================================

# -----------------------------------------------------------------------------
# Ứng dụng
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
WEB_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16) — dùng ở Phase 1
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://ats:ats_local_password@localhost:5433/ats?schema=public

# -----------------------------------------------------------------------------
# Redis — hàng đợi BullMQ + cache + rate limit (ADR-05)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=ats

# -----------------------------------------------------------------------------
# Xác thực (US-01)
# Sinh JWT_SECRET bằng:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-please-use-a-256-bit-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Object Storage (ADR-06) — RustFS (S3-compatible) ở local, S3/R2 ở production
# -----------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_CV=cv-files
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=300

# -----------------------------------------------------------------------------
# Email (US-07) — Mailpit ở local (UI: http://localhost:8025)
# -----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ATS Tuyển dụng <no-reply@ats.local>"

# -----------------------------------------------------------------------------
# AI Service (US-04, US-08)
# AI_INTERNAL_TOKEN dùng cho header X-Internal-Token giữa Core API và AI Service
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8010
AI_INTERNAL_TOKEN=change-me-internal-service-token
AI_ANALYZE_TIMEOUT_MS=120000
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_ENABLED=true
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_API_KEY=
# Để trống = api.openai.com. Đặt base URL nếu dùng Azure/OpenRouter/Ollama /v1.
LLM_API_BASE=
LLM_TIMEOUT_MS=30000
# Giới hạn đầu vào chống prompt quá dài
MAX_CV_CHARS=15000
MAX_JD_CHARS=20000
MAX_OCR_PAGES=10

# -----------------------------------------------------------------------------
# Bảo mật & chống lạm dụng
# -----------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
RATE_LIMIT_APPLY_PER_HOUR=5
RATE_LIMIT_TRACK_PER_10MIN=20
RATE_LIMIT_LOGIN_PER_15MIN=10

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
